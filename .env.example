# Local development environment variables. Copy to `.env` and fill in real values;
# `.env` is gitignored. The API also reads these directly as environment variables
# via the standard .NET configuration provider (double-underscore -> nested keys).

# --- Database provider (ADR-8) ---
# Postgres | SqlServer | MySql | Sqlite. Local Development defaults to Sqlite when
# unset; every other environment defaults to Postgres.
Database__Provider=Sqlite

# --- PostgreSQL (only needed when Database__Provider=Postgres) ---
POSTGRES_DB=edms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devonly

# --- API ---
# SQLite (dev default): relative file names are anchored to the API content root.
ConnectionStrings__Default=Data Source=edms-dev.db
# PostgreSQL: ConnectionStrings__Default=Host=localhost;Port=5432;Database=edms;Username=postgres;Password=

# --- First-run seed (System Administrator, forced password reset) ---
Seed__AdminEmail=
Seed__AdminTempPassword=

# --- JWT (RS256) ---
# PEM-encoded RSA private/public key pair. Keep real values out of source control.
Jwt__PrivateKey=
Jwt__PublicKey=
Jwt__Issuer=edms
Jwt__Audience=edms-api
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=14

# --- OIDC federation (optional; leave Authority empty to hide the SSO button) ---
# `docker compose up -d` overrides these with its clickable mock provider at
# http://host.docker.internal:4011/default (demo login: demo-user / any password).
Oidc__Authority=
Oidc__ClientId=
Oidc__ClientSecret=
Oidc__CallbackPath=/api/v1/auth/sso/oidc/callback
# Keep true for real providers. The local HTTP-only mock uses false in docker-compose.
Oidc__RequireHttpsMetadata=true

# --- SAML2 federation (optional; leave IdpMetadataUrl empty to hide the SSO button) ---
# Use IdpMetadataUrl for a standard metadata document, or leave it empty and provide
# IdpEntityId, IdpSingleSignOnUrl, and a pinned IdpSigningCertificate instead.
Saml__IdpMetadataUrl=
Saml__IdpEntityId=
Saml__IdpSingleSignOnUrl=
Saml__IdpSigningCertificate=
Saml__EntityId=urn:edms:saml
Saml__SigningCertificate=
Saml__SigningCertificatePassword=
Saml__CallbackPath=/api/v1/auth/sso/saml/acs
Saml__MetadataPath=/api/v1/auth/sso/saml/metadata
Saml__EmailAttributeName=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
Saml__SignAuthnRequest=false

# --- Docker Compose IdP/secrets aliases ---
# These uppercase names are consumed by docker-compose.yml. They make the same
# compose file usable with the pinned local test IdPs and with a staging secret
# manager. Leave the secret values blank locally to use the safe demo defaults;
# never commit real provider credentials or private keys here.
# The staging workflow expects encrypted secrets named OIDC_CLIENT_SECRET,
# SAML_IDP_SIGNING_CERT, SAML_SP_SIGNING_CERT, and (for PFX bundles) the
# optional SAML_SP_SIGNING_CERT_PASSWORD.
OIDC_AUTHORITY=http://host.docker.internal:4011/default
OIDC_CLIENT_ID=edms-demo-client
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_PATH=/api/v1/auth/sso/oidc/callback
OIDC_REQUIRE_HTTPS_METADATA=false
SAML_IDP_ENTITY_ID=urn:edms:test-saml-idp
SAML_IDP_SSO_URL=https://localhost:4443/simplesaml/saml2/idp/SSOService.php
# Local default reads the public certificate generated by the demo IdP volume.
SAML_IDP_SIGNING_CERT_PATH=/run/saml/server.crt
# A staging PEM bundle may contain the SP certificate and private key.
SAML_SP_SIGNING_CERT_PATH=
SAML_SP_SIGNING_CERT_PASSWORD=
SAML_SIGN_AUTHN_REQUEST=false
SAML_ENTITY_ID=urn:edms:saml
SAML_CALLBACK_PATH=/api/v1/auth/sso/saml/acs
SAML_METADATA_PATH=/api/v1/auth/sso/saml/metadata
SAML_EMAIL_ATTRIBUTE_NAME=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# Host directory mounted read-only at /run/saml-secrets in the API container.
SAML_SECRETS_DIR=./.secrets/saml

# --- SMTP (Mailhog in local dev) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__EnableSsl=false
Smtp__From=no-reply@edms.local
Smtp__Username=
Smtp__Password=

# --- SPA client (for building reset links) ---
Client__BaseUrl=http://localhost:5173

# --- Storage ---
Storage__RootPath=storage
Storage__MaxUploadSizeBytes=262144000

# --- Recycle bin ---
RecycleBin__RetentionDays=90
