# Local development environment variables. Copy to `.env` and fill in real values;
# `.env` is gitignored. The API also reads these directly as environment variables
# via the standard .NET configuration provider (double-underscore -> nested keys).

# --- PostgreSQL ---
POSTGRES_DB=edms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devonly

# --- API ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=edms;Username=postgres;Password=

# --- First-run seed (System Administrator, forced password reset) ---
Seed__AdminEmail=
Seed__AdminTempPassword=

# --- JWT (RS256) ---
# PEM-encoded RSA private/public key pair. Keep real values out of source control.
Jwt__PrivateKey=
Jwt__PublicKey=
Jwt__Issuer=edms
Jwt__Audience=edms-api
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=14

# --- SMTP (Mailhog in local dev) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__EnableSsl=false
Smtp__From=no-reply@edms.local
Smtp__Username=
Smtp__Password=

# --- SPA client (for building reset links) ---
Client__BaseUrl=http://localhost:5173

# --- Storage ---
Storage__RootPath=storage
Storage__MaxUploadSizeBytes=262144000

# --- Recycle bin ---
RecycleBin__RetentionDays=90
