# Local development environment variables. Copy to `.env` and fill in real values;
# `.env` is gitignored. The API also reads these directly as environment variables
# via the standard .NET configuration provider (double-underscore -> nested keys).

# --- Database provider (ADR-8) ---
# Postgres | SqlServer | MySql | Sqlite. Local Development defaults to Sqlite when
# unset; every other environment defaults to Postgres.
Database__Provider=Sqlite

# --- PostgreSQL (only needed when Database__Provider=Postgres) ---
POSTGRES_DB=edms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devonly

# --- API ---
# SQLite (dev default): relative file names are anchored to the API content root.
ConnectionStrings__Default=Data Source=edms-dev.db
# PostgreSQL: ConnectionStrings__Default=Host=localhost;Port=5432;Database=edms;Username=postgres;Password=

# --- First-run seed (System Administrator, forced password reset) ---
Seed__AdminEmail=
Seed__AdminTempPassword=

# --- JWT (RS256) ---
# PEM-encoded RSA private/public key pair. Keep real values out of source control.
Jwt__PrivateKey=
Jwt__PublicKey=
Jwt__Issuer=edms
Jwt__Audience=edms-api
Jwt__AccessTokenLifetimeMinutes=15
Jwt__RefreshTokenLifetimeDays=14

# --- OIDC federation (optional; leave Authority empty to hide the SSO button) ---
# `docker compose up -d` overrides these with its clickable mock provider at
# http://host.docker.internal:4011/default (demo login: demo-user / any password).
Oidc__Authority=
Oidc__ClientId=
Oidc__ClientSecret=
Oidc__CallbackPath=/api/v1/auth/sso/oidc/callback
# Keep true for real providers. The local HTTP-only mock uses false in docker-compose.
Oidc__RequireHttpsMetadata=true

# --- SMTP (Mailhog in local dev) ---
Smtp__Host=localhost
Smtp__Port=1025
Smtp__EnableSsl=false
Smtp__From=no-reply@edms.local
Smtp__Username=
Smtp__Password=

# --- SPA client (for building reset links) ---
Client__BaseUrl=http://localhost:5173

# --- Storage ---
Storage__RootPath=storage
Storage__MaxUploadSizeBytes=262144000

# --- Recycle bin ---
RecycleBin__RetentionDays=90
